generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sender {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  maxEmailsPerHour   Int      @default(200) 
  createdAt          DateTime @default(now())

  emails             Email[]
  rateLimitWindows   RateLimitWindow[]
}

enum EmailStatus {
  SCHEDULED   
  QUEUED      
  PROCESSING 
  SENT        
  FAILED     
  RATE_LIMITED 
}

model Email {
  id            String      @id @default(uuid())
  to            String
  subject       String
  body          String

  senderId      String
  sender        Sender      @relation(fields: [senderId], references: [id])

  status        EmailStatus @default(SCHEDULED)
  scheduledAt   DateTime   
  sentAt        DateTime?   

  bullJobId     String?     @unique

  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([senderId, status])
  @@index([scheduledAt])
}

model RateLimitWindow {
  id          String   @id @default(uuid())
  senderId    String
  sender      Sender   @relation(fields: [senderId], references: [id])
  hourWindow  String   // e.g. "2026-08-28T14"
  count       Int      @default(0)

  @@unique([senderId, hourWindow])
}

model SlackConnection {
  id           String   @id @default(uuid())
  teamId       String   @unique   
  accessToken  String             
  channelId    String           
  createdAt    DateTime @default(now())
}